{
  "name": "mediadb",
  "version": "0.6.0",
  "private": true,
  "description": "manager for movie and tv shows",
  "type": "module",
  "scripts": {
    "build": "tauri build",
    "build-debug": "tauri build --debug",
    "dev": "__NV_DISABLE_EXPLICIT_SYNC=1  tauri dev",
    "lint": "biome check --write . && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "prepare": "husky",
    "tauri": "tauri",
    "test": "vitest run && cargo test --manifest-path src-tauri/Cargo.toml",
    "type-check": "tsc --pretty --noEmit",
    "vite-build": "tsc && vite build",
    "vite-dev": "vite"
  },
  "dependencies": {
    "@solid-primitives/scheduled": "1.5.3",
    "@tailwindcss/vite": "4.3.2",
    "@tanstack/solid-form": "1.33.0",
    "@tanstack/solid-query": "5.101.1",
    "@tanstack/solid-router": "1.170.16",
    "@tanstack/solid-store": "0.11.0",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.1",
    "@tauri-apps/plugin-fs": "2.5.1",
    "@tauri-apps/plugin-log": "2.8.0",
    "@tauri-apps/plugin-notification": "2.3.3",
    "@tauri-apps/plugin-opener": "2.5.4",
    "clsx": "2.1.1",
    "daisyui": "5.6.6",
    "immutable": "5.1.9",
    "solid-js": "1.9.14",
    "tailwind-merge": "3.6.0",
    "tailwindcss-animate": "1.0.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@tanstack/router-plugin": "1.168.18",
    "@tanstack/solid-query-devtools": "5.101.1",
    "@tanstack/solid-router-devtools": "1.167.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "24.13.2",
    "husky": "9.1.7",
    "tailwindcss": "4.3.2",
    "typescript": "6.0.3",
    "vite": "8.1.3",
    "vite-plugin-solid": "2.11.12",
    "vitest": "4.1.9"
  }
}
