{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":disableDependencyDashboard"],
  "schedule": ["every weekend"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Version pins for the bundled libimage build",
      "managerFilePatterns": ["/^native/versions\\.sh$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)(?: registryUrl=(?<registryUrl>\\S+))?(?: versioning=(?<versioning>\\S+))?(?: extractVersion=(?<extractVersion>\\S+))?\\s*\\n[A-Z0-9_]+(?:_VERSION|_TAG)=(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "groupName": "native-libimage",
      "matchFileNames": ["native/versions.sh"],
      "automerge": false
    },
    {
      "groupName": "javafx",
      "matchPackageNames": ["org.openjfx:*", "org.controlsfx:*"]
    },
    {
      "groupName": "libraries",
      "matchPackageNames": ["tools.jackson*", "ch.qos.logback:*", "org.slf4j:*"]
    },
    {
      "groupName": "storage",
      "matchPackageNames": ["org.xerial:*", "com.github.ben-manes.caffeine:*"]
    },
    {
      "groupName": "testing",
      "matchPackageNames": ["org.junit*", "org.mockito:*"]
    },
    {
      "groupName": "maven-plugins",
      "matchPackageNames": [
        "org.apache.maven.plugins:*",
        "org.codehaus.mojo:*",
        "org.panteleyev:*",
        "com.diffplug.spotless:*",
        "com.puppycrawl.tools:*"
      ]
    },
    {
      "groupName": "github-actions",
      "matchManagers": ["github-actions"]
    }
  ]
}
